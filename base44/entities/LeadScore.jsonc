{
  "name": "LeadScore",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "website_visits": {
      "type": "number",
      "default": 0
    },
    "property_views": {
      "type": "number",
      "default": 0
    },
    "brochures_downloaded": {
      "type": "number",
      "default": 0
    },
    "emails_opened": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "calls": {
      "type": "number",
      "default": 0
    },
    "inspections": {
      "type": "number",
      "default": 0
    },
    "budget_match": {
      "type": "boolean",
      "default": false
    },
    "timeline_score": {
      "type": "number",
      "default": 0,
      "description": "Urgency/timeline readiness score"
    },
    "total_score": {
      "type": "number",
      "default": 0,
      "description": "Calculated total score"
    },
    "score_level": {
      "type": "string",
      "enum": [
        "cold",
        "warm",
        "hot"
      ],
      "default": "cold"
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "lead_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}