{
  "name": "SavedSearch",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who saved this search"
    },
    "search_name": {
      "type": "string",
      "description": "User-defined name for this saved search"
    },
    "search_query": {
      "type": "string",
      "description": "The text query string"
    },
    "filters": {
      "type": "object",
      "description": "Applied filter object"
    },
    "result_type": {
      "type": "string",
      "enum": [
        "all",
        "properties",
        "projects",
        "agents",
        "locations"
      ],
      "default": "all"
    },
    "alerts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether email alerts are active for new matching results"
    },
    "last_match_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "search_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}