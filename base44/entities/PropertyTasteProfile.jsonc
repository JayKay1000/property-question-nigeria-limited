{
  "name": "PropertyTasteProfile",
  "type": "object",
  "title": "Property Taste Profile",
  "description": "A user's explicit property-discovery preferences for the personalized recommendation engine. One record per user. Private to the owner \u2014 never exposed to agents or other buyers.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Platform user ID of the profile owner (denormalized for RLS ownership checks)"
    },
    "transaction_purpose": {
      "type": "string",
      "enum": [
        "sale",
        "rent",
        "lease",
        "any"
      ],
      "default": "any",
      "description": "Whether the user is looking to buy, rent, or lease"
    },
    "preferred_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred states, cities, LGAs, or districts"
    },
    "preferred_property_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred property types (e.g. house, apartment, land)"
    },
    "budget_min_ngn": {
      "type": "number",
      "description": "Minimum budget in NGN"
    },
    "budget_max_ngn": {
      "type": "number",
      "description": "Maximum budget in NGN"
    },
    "min_bedrooms": {
      "type": "number",
      "description": "Minimum number of bedrooms required"
    },
    "preferred_amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Amenities the user cares about"
    },
    "condition_preference": {
      "type": "string",
      "description": "Preferred property condition (e.g. new, excellent, good)"
    },
    "furnishing_preference": {
      "type": "string",
      "description": "Preferred furnishing status (e.g. furnished, semi_furnished, unfurnished)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "affordability",
        "location",
        "space",
        "amenities",
        "balanced"
      ],
      "default": "balanced",
      "description": "Which preference category weighs most heavily in ranking"
    },
    "personalization_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the recommendation engine is active for this user"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user completed the preference setup"
    },
    "onboarding_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "onboarding_skipped": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user dismissed the onboarding prompt"
    },
    "onboarding_skipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}