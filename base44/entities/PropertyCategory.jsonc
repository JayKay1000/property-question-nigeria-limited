{
  "name": "PropertyCategory",
  "type": "object",
  "properties": {
    "category_key": {
      "type": "string",
      "description": "Unique category identifier (e.g. sale, lease, rent, joint_venture)"
    },
    "category_name": {
      "type": "string",
      "description": "Display name"
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "category_key",
    "category_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}