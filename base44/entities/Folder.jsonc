{
  "name": "Folder",
  "type": "object",
  "properties": {
    "folder_name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL/path-friendly slug"
    },
    "description": {
      "type": "string"
    },
    "parent_folder_id": {
      "type": "string",
      "description": "Parent folder for hierarchical nesting (null = root)"
    },
    "parent_folder_name": {
      "type": "string"
    },
    "folder_path": {
      "type": "string",
      "description": "Full hierarchical path (e.g. /Properties/Lagos/Ikoyi)"
    },
    "depth_level": {
      "type": "number",
      "default": 0,
      "description": "Nesting depth (0 = root)"
    },
    "module": {
      "type": "string",
      "enum": [
        "properties",
        "projects",
        "buy2flip",
        "agents",
        "customers",
        "construction",
        "marketing",
        "corporate",
        "hr",
        "legal",
        "media",
        "general"
      ],
      "description": "Primary module this folder belongs to"
    },
    "icon": {
      "type": "string",
      "description": "Icon identifier for UI"
    },
    "color": {
      "type": "string",
      "description": "Hex color for UI display"
    },
    "item_count": {
      "type": "number",
      "default": 0,
      "description": "Number of items directly in this folder"
    },
    "total_size_bytes": {
      "type": "number",
      "default": 0,
      "description": "Total size of all items in this folder"
    },
    "is_system_folder": {
      "type": "boolean",
      "default": false,
      "description": "System folders cannot be deleted"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "folder_name",
    "module"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}