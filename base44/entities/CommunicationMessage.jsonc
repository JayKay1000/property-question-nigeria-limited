{
  "name": "CommunicationMessage",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "description": "Reference to CommunicationThread"
    },
    "thread_reference": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "default": "outbound"
    },
    "channel": {
      "type": "string",
      "enum": [
        "in_app",
        "email",
        "sms",
        "whatsapp",
        "push"
      ],
      "default": "in_app"
    },
    "sender_user_id": {
      "type": "string",
      "description": "User who sent the message"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_phone": {
      "type": "string"
    },
    "recipient_user_id": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "recipient_phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Message body \u2014 plain text or rich text"
    },
    "body_format": {
      "type": "string",
      "enum": [
        "plain",
        "html",
        "markdown"
      ],
      "default": "plain"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "File URLs and metadata"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "queued",
        "sent",
        "delivered",
        "read",
        "failed",
        "bounced"
      ],
      "default": "sent"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "automated",
        "campaign",
        "template",
        "workflow"
      ],
      "default": "manual"
    },
    "template_id": {
      "type": "string",
      "description": "Reference to NotificationTemplate"
    },
    "campaign_id": {
      "type": "string",
      "description": "Reference to CommunicationCampaign"
    },
    "notification_log_id": {
      "type": "string",
      "description": "Reference to NotificationLog"
    },
    "in_reply_to_id": {
      "type": "string",
      "description": "Reference to parent message for threading"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "failed_reason": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "edited_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "thread_id",
    "direction",
    "body"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}