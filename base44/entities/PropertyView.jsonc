{
  "name": "PropertyView",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "property_title": {
      "type": "string"
    },
    "viewer_id": {
      "type": "string",
      "description": "User ID if authenticated"
    },
    "viewer_ip": {
      "type": "string",
      "description": "IP address (anonymized where appropriate)"
    },
    "view_date": {
      "type": "string",
      "format": "date-time"
    },
    "view_duration_seconds": {
      "type": "number",
      "description": "Time spent on property page"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "mobile_app",
        "search",
        "featured_link",
        "social_media",
        "email",
        "direct",
        "other"
      ],
      "default": "website"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "tablet"
      ]
    },
    "referrer_url": {
      "type": "string"
    },
    "clicked_contact": {
      "type": "boolean",
      "default": false
    },
    "viewed_map": {
      "type": "boolean",
      "default": false
    },
    "viewed_video": {
      "type": "boolean",
      "default": false
    },
    "viewed_tour": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "property_id",
    "view_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.viewer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}