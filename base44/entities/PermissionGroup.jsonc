{
  "name": "PermissionGroup",
  "type": "object",
  "properties": {
    "group_key": {
      "type": "string",
      "description": "Unique group identifier (e.g. properties, crm, security)"
    },
    "group_name": {
      "type": "string",
      "description": "Display name (e.g. Properties, CRM, Security)"
    },
    "description": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "description": "Platform module this group belongs to"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "group_key",
    "group_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}