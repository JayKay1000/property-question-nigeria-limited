{
  "name": "NotificationRule",
  "type": "object",
  "properties": {
    "rule_code": {
      "type": "string",
      "description": "Unique e.g. lead_created_notify_agent"
    },
    "rule_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "trigger_entity": {
      "type": "string",
      "description": "Entity to watch e.g. Lead, InspectionRequest"
    },
    "trigger_event": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "deleted",
        "status_changed",
        "field_changed",
        "scheduled",
        "reminder"
      ],
      "default": "created"
    },
    "trigger_condition": {
      "type": "object",
      "description": "MongoDB-style filter for additional conditions"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "record_owner",
        "assigned_user",
        "role_based",
        "specific_users",
        "entity_related_users"
      ],
      "default": "assigned_user"
    },
    "target_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "sms",
          "push",
          "in_app",
          "whatsapp"
        ]
      }
    },
    "template_id": {
      "type": "string",
      "description": "Reference to NotificationTemplate"
    },
    "delay_minutes": {
      "type": "number",
      "default": 0
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence_cron": {
      "type": "string",
      "description": "Cron expression"
    },
    "max_sends_per_user": {
      "type": "number",
      "description": "Cap notifications per user per trigger cycle"
    },
    "cooldown_minutes": {
      "type": "number",
      "description": "Prevent duplicate notifications within this window"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "created_by_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "rule_code",
    "trigger_entity",
    "trigger_event",
    "target_audience"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}