{
  "name": "PropertyDocument",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Reference to Document entity"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "property_reference": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "document_category": {
      "type": "string",
      "enum": [
        "survey",
        "layout",
        "title",
        "approval",
        "marketing_brochure",
        "inspection_report",
        "construction_certificate",
        "valuation_report",
        "title_search",
        "encumbrance_report",
        "other"
      ]
    },
    "document_subtype": {
      "type": "string",
      "description": "More specific subcategory"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "issued_by": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected",
        "expired"
      ],
      "default": "unverified"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "approved",
        "rejected",
        "superseded"
      ],
      "default": "draft"
    },
    "is_current_version": {
      "type": "boolean",
      "default": true
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "file_url": {
      "type": "string"
    },
    "file_url_secure": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "property_id",
    "document_category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}