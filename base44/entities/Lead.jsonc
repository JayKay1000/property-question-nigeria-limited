{
  "name": "Lead",
  "type": "object",
  "properties": {
    "lead_reference": {
      "type": "string",
      "description": "Unique lead reference (e.g. PQ-LEAD-2024-0001)"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer entity if converted"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "referral",
        "social_media",
        "walk_in",
        "call",
        "email",
        "buy2flip",
        "google_ads",
        "facebook",
        "instagram",
        "linkedin",
        "whatsapp",
        "sms_campaign",
        "email_campaign",
        "event",
        "partner",
        "agent",
        "other"
      ],
      "default": "website"
    },
    "source_key": {
      "type": "string",
      "description": "Reference to LeadSource entity"
    },
    "campaign_id": {
      "type": "string",
      "description": "Reference to Campaign entity"
    },
    "campaign_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "unqualified",
        "interested",
        "inspection_scheduled",
        "negotiating",
        "reserved",
        "converted",
        "lost",
        "dormant",
        "nurturing"
      ],
      "default": "new"
    },
    "status_key": {
      "type": "string",
      "description": "Reference to LeadStatus entity"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "lead_score": {
      "type": "number",
      "default": 0,
      "description": "Dynamic lead score"
    },
    "score_level": {
      "type": "string",
      "enum": [
        "cold",
        "warm",
        "hot"
      ],
      "default": "cold"
    },
    "interest_type": {
      "type": "string"
    },
    "interest_ref": {
      "type": "string",
      "description": "Reference to specific property or project"
    },
    "property_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "budget_range_min": {
      "type": "number"
    },
    "budget_range_max": {
      "type": "number"
    },
    "preferred_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_close_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "next_follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string"
    },
    "converted_to_customer_id": {
      "type": "string"
    },
    "converted_at": {
      "type": "string",
      "format": "date-time"
    },
    "conversion_value_ngn": {
      "type": "number"
    },
    "lost_reason": {
      "type": "string"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "full_name",
    "status",
    "source"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}