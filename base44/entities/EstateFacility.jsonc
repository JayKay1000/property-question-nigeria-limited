{
  "name": "EstateFacility",
  "type": "object",
  "properties": {
    "estate_id": {
      "type": "string",
      "description": "Reference to Estate entity"
    },
    "estate_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "facility_type": {
      "type": "string",
      "enum": [
        "park",
        "playground",
        "club_house",
        "health_centre",
        "school",
        "shopping_centre",
        "sports_complex",
        "swimming_pool",
        "gym",
        "community_hall",
        "place_of_worship",
        "other"
      ],
      "description": "Type of facility"
    },
    "description": {
      "type": "string"
    },
    "capacity": {
      "type": "number",
      "description": "Capacity if applicable"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "under_construction",
        "completed",
        "operational",
        "maintained"
      ],
      "default": "planned"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "estate_id",
    "facility_name",
    "facility_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}