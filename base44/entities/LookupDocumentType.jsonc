{
  "name": "LookupDocumentType",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "property",
        "legal",
        "identity",
        "financial",
        "construction",
        "marketing"
      ]
    },
    "description": {
      "type": "string"
    },
    "requires_expiry": {
      "type": "boolean",
      "default": false
    },
    "requires_verification": {
      "type": "boolean",
      "default": true
    },
    "sensitivity_level": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "default": "internal"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "label"
  ]
}