{
  "name": "EstateSection",
  "type": "object",
  "properties": {
    "estate_id": {
      "type": "string",
      "description": "Reference to Estate entity"
    },
    "estate_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "section_name": {
      "type": "string",
      "description": "Section name (e.g. Residential Zone, Commercial Zone)"
    },
    "section_type": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "mixed_use",
        "recreation",
        "utility",
        "industrial"
      ],
      "default": "residential"
    },
    "description": {
      "type": "string"
    },
    "total_plots": {
      "type": "number",
      "default": 0
    },
    "area_sqm": {
      "type": "number",
      "description": "Section area in square meters"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "estate_id",
    "section_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}