{
  "name": "LoginHistory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the platform User ID"
    },
    "user_email": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "device_name": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "login_method": {
      "type": "string",
      "enum": [
        "email",
        "google",
        "microsoft",
        "apple",
        "facebook",
        "sso"
      ],
      "default": "email"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "blocked",
        "mfa_required"
      ],
      "default": "success"
    },
    "failure_reason": {
      "type": "string",
      "description": "Reason for failure if applicable"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier if login succeeded"
    }
  },
  "required": [
    "user_id",
    "result"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}