{
  "name": "AgentDocument",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Reference to Document entity"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "government_id",
        "passport_photograph",
        "utility_bill",
        "professional_certificate",
        "signed_agreement",
        "agency_license",
        "tax_identification",
        "bank_verification",
        "proof_of_address",
        "employment_letter",
        "drivers_license",
        "national_id",
        "international_passport",
        "voter_card",
        "selfie_with_id",
        "cac_certificate",
        "other"
      ]
    },
    "document_number": {
      "type": "string",
      "description": "Official ID/certificate number"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "issued_by": {
      "type": "string",
      "description": "Issuing authority"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected",
        "expired"
      ],
      "default": "unverified"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_url_secure": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "is_confidential": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "agent_id",
    "document_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "data.verified_by": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}