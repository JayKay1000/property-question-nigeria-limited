{
  "name": "PropertyPricing",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "current_price": {
      "type": "number",
      "description": "Current listing price"
    },
    "previous_price": {
      "type": "number",
      "description": "Previous price"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "price_per_sqm": {
      "type": "number",
      "description": "Price per square meter"
    },
    "is_negotiable": {
      "type": "boolean",
      "default": true
    },
    "payment_plan_available": {
      "type": "boolean",
      "default": false
    },
    "buy2flip_eligible": {
      "type": "boolean",
      "default": false
    },
    "discount_amount": {
      "type": "number"
    },
    "discount_percentage": {
      "type": "number"
    },
    "promotional_price": {
      "type": "number",
      "description": "Temporary promotional price"
    },
    "promotion_start_date": {
      "type": "string",
      "format": "date"
    },
    "promotion_end_date": {
      "type": "string",
      "format": "date"
    },
    "effective_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this pricing takes effect"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this pricing expires"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal pricing notes (restricted access)"
    }
  },
  "required": [
    "property_id",
    "current_price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}