{
  "name": "EngineeringReport",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project entity"
    },
    "project_name": {
      "type": "string"
    },
    "estate_id": {
      "type": "string"
    },
    "report_title": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "site_inspection",
        "soil_test",
        "structural",
        "progress",
        "completion",
        "environmental",
        "survey",
        "other"
      ],
      "default": "progress"
    },
    "engineer_name": {
      "type": "string"
    },
    "engineer_organization": {
      "type": "string"
    },
    "engineer_license_number": {
      "type": "string"
    },
    "inspection_date": {
      "type": "string",
      "format": "date"
    },
    "progress_notes": {
      "type": "string",
      "description": "Detailed progress notes"
    },
    "findings": {
      "type": "string"
    },
    "recommendations": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Document/image attachment URLs"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "reviewed",
        "approved",
        "rejected"
      ],
      "default": "draft"
    },
    "reviewed_by": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "report_title",
    "inspection_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}