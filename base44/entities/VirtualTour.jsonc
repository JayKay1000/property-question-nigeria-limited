{
  "name": "VirtualTour",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "tour_url": {
      "type": "string",
      "description": "URL to the virtual tour"
    },
    "provider": {
      "type": "string",
      "enum": [
        "matterport",
        "kuula",
        "roundme",
        "custom_360",
        "panorama",
        "guided_tour",
        "other"
      ],
      "description": "Tour platform/provider"
    },
    "tour_type": {
      "type": "string",
      "enum": [
        "360_tour",
        "vr_tour",
        "panorama",
        "guided_tour",
        "interactive"
      ],
      "default": "360_tour"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "is_matterport_ready": {
      "type": "boolean",
      "default": false,
      "description": "Future-ready Matterport integration flag"
    }
  },
  "required": [
    "property_id",
    "tour_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}