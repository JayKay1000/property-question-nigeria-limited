{
  "name": "ProjectMilestone",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project entity"
    },
    "project_name": {
      "type": "string"
    },
    "milestone_name": {
      "type": "string",
      "description": "Milestone name (e.g. Land Acquisition, Survey, Road Construction)"
    },
    "description": {
      "type": "string"
    },
    "planned_date": {
      "type": "string",
      "format": "date"
    },
    "actual_date": {
      "type": "string",
      "format": "date"
    },
    "percentage_complete": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "delayed",
        "cancelled"
      ],
      "default": "not_started"
    },
    "responsible_team": {
      "type": "string",
      "description": "Team or person responsible"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "project_id",
    "milestone_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}