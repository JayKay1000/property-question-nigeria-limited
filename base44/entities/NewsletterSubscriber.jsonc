{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "properties",
          "projects",
          "buy2flip",
          "market_insights",
          "investment_tips"
        ]
      }
    },
    "source_page": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "subscribed",
        "unsubscribed",
        "bounced",
        "pending"
      ],
      "default": "subscribed"
    },
    "subscribed_date": {
      "type": "string",
      "format": "date-time"
    },
    "unsubscribed_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}