{
  "name": "CMSMenu",
  "type": "object",
  "properties": {
    "menu_name": {
      "type": "string"
    },
    "menu_location": {
      "type": "string",
      "enum": [
        "header",
        "footer",
        "mobile",
        "sidebar",
        "mega_menu"
      ],
      "default": "header"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "description": "Lucide icon name"
          },
          "target": {
            "type": "string",
            "enum": [
              "internal",
              "external"
            ],
            "default": "internal"
          },
          "sort_order": {
            "type": "number",
            "default": 0
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "sort_order": {
                  "type": "number",
                  "default": 0
                }
              }
            }
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "menu_name",
    "menu_location"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}