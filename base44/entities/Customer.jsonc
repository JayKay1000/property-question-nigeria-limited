{
  "name": "Customer",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string",
      "description": "Unique customer reference (e.g. PQ-CUST-2024-0001)"
    },
    "user_id": {
      "type": "string",
      "description": "Linked user account (optional)"
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "individual",
        "corporate",
        "investor",
        "diaspora",
        "government"
      ],
      "default": "individual"
    },
    "first_name": {
      "type": "string"
    },
    "middle_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "full_name": {
      "type": "string",
      "description": "Computed full name"
    },
    "organization_id": {
      "type": "string",
      "description": "Reference to Organization if corporate customer"
    },
    "organization_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "secondary_phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "occupation": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "annual_income_range": {
      "type": "string",
      "enum": [
        "below_1m",
        "1m_to_5m",
        "5m_to_10m",
        "10m_to_50m",
        "50m_to_100m",
        "above_100m",
        "undisclosed"
      ]
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "sms",
        "whatsapp",
        "in_person"
      ],
      "default": "phone"
    },
    "address": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "lga": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "blacklisted",
        "dormant",
        "vip"
      ],
      "default": "active"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "preferred_property_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_range_min": {
      "type": "number"
    },
    "budget_range_max": {
      "type": "number"
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": [
        "lead",
        "prospect",
        "active_buyer",
        "owner",
        "repeat_buyer",
        "advocate",
        "churned"
      ],
      "default": "lead"
    },
    "assigned_agent_id": {
      "type": "string"
    },
    "assigned_agent_name": {
      "type": "string"
    },
    "relationship_manager_id": {
      "type": "string",
      "description": "Assigned relationship manager user ID"
    },
    "relationship_manager_name": {
      "type": "string"
    },
    "total_purchases": {
      "type": "number",
      "default": 0
    },
    "total_invested_ngn": {
      "type": "number",
      "default": 0
    },
    "lead_source": {
      "type": "string",
      "description": "Original lead source key"
    },
    "consent_marketing": {
      "type": "boolean",
      "default": false
    },
    "consent_data_processing": {
      "type": "boolean",
      "default": true
    },
    "consent_third_party": {
      "type": "boolean",
      "default": false
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "full_name",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.assigned_agent_id": "{{user.id}}"
        },
        {
          "data.relationship_manager_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.assigned_agent_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}