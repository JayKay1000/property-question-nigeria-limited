{
  "name": "PlotOwnershipHistory",
  "type": "object",
  "properties": {
    "plot_id": {
      "type": "string",
      "description": "Reference to EstatePlot entity"
    },
    "plot_number": {
      "type": "string"
    },
    "estate_id": {
      "type": "string"
    },
    "estate_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "previous_owner_name": {
      "type": "string"
    },
    "previous_owner_id": {
      "type": "string"
    },
    "new_owner_name": {
      "type": "string"
    },
    "new_owner_id": {
      "type": "string"
    },
    "transfer_date": {
      "type": "string",
      "format": "date"
    },
    "transfer_method": {
      "type": "string",
      "enum": [
        "sale",
        "gift",
        "inheritance",
        "court_order",
        "allocation",
        "exchange",
        "other"
      ],
      "default": "sale"
    },
    "transfer_amount_ngn": {
      "type": "number",
      "description": "Transaction amount if applicable"
    },
    "supporting_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Document URLs supporting the transfer"
    },
    "verified_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "plot_id",
    "new_owner_name",
    "transfer_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.new_owner_id": "{{user.id}}"
        },
        {
          "data.previous_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}