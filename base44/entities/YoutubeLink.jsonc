{
  "name": "YoutubeLink",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "youtube_url": {
      "type": "string",
      "description": "Full YouTube URL"
    },
    "video_id": {
      "type": "string",
      "description": "YouTube video ID extracted from URL"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "YouTube thumbnail image URL"
    },
    "channel_name": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "is_embeddable": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "property_id",
    "youtube_url",
    "video_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}