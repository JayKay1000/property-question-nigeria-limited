{
  "name": "SiteContent",
  "type": "object",
  "properties": {
    "content_key": {
      "type": "string",
      "description": "Unique identifier (e.g. home_hero, about_mission)"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "page",
        "section",
        "snippet",
        "banner",
        "settings"
      ],
      "default": "section"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Rich text content"
    },
    "metadata": {
      "type": "object",
      "description": "Flexible metadata (images, links, config)"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "seo_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "published_date": {
      "type": "string",
      "format": "date-time"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "content_key",
    "content_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}