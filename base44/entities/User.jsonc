{
  "properties": {
    "role": {
      "type": "string",
      "description": "Primary role of the user in the app (RBAC)",
      "enum": [
        "super_admin",
        "administrator",
        "department_manager",
        "hr_officer",
        "marketing_officer",
        "finance_officer",
        "legal_officer",
        "customer_service",
        "buy2flip_manager",
        "property_manager",
        "construction_officer",
        "sales_executive",
        "verified_agent",
        "prospective_agent",
        "customer",
        "admin",
        "user",
        "agent",
        "staff"
      ],
      "default": "customer"
    },
    "additional_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional roles assigned to the user for multi-role support",
      "default": []
    },
    "custom_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional permissions granted beyond the user's role(s)",
      "default": []
    },
    "department": {
      "type": "string",
      "description": "Department the user belongs to (for department-based access control)"
    },
    "agent_verification_status": {
      "type": "string",
      "description": "Verification status for agent applications",
      "enum": [
        "not_applicable",
        "pending",
        "under_review",
        "approved",
        "rejected",
        "returned",
        "suspended"
      ],
      "default": "not_applicable"
    },
    "first_name": {
      "type": "string",
      "description": "User's first name"
    },
    "middle_name": {
      "type": "string",
      "description": "User's middle name (optional)"
    },
    "last_name": {
      "type": "string",
      "description": "User's last name"
    },
    "phone": {
      "type": "string",
      "description": "User's phone number"
    },
    "country": {
      "type": "string",
      "description": "User's country of residence"
    },
    "state": {
      "type": "string",
      "description": "User's state/province"
    },
    "city": {
      "type": "string",
      "description": "User's city"
    },
    "address": {
      "type": "string",
      "description": "User's residential address"
    },
    "referral_code": {
      "type": "string",
      "description": "Referral code used during registration"
    },
    "communication_preference": {
      "type": "string",
      "description": "Preferred communication method",
      "enum": [
        "email",
        "sms",
        "both"
      ],
      "default": "email"
    },
    "marketing_consent": {
      "type": "boolean",
      "description": "Consent to receive marketing communications",
      "default": false
    },
    "newsletter_subscribed": {
      "type": "boolean",
      "description": "Subscribed to newsletter",
      "default": false
    },
    "phone_verified": {
      "type": "boolean",
      "description": "Whether phone number has been verified",
      "default": false
    },
    "account_status": {
      "type": "string",
      "description": "Current account status",
      "enum": [
        "pending_verification",
        "email_verified",
        "phone_verified",
        "pending_approval",
        "active",
        "suspended",
        "rejected",
        "disabled"
      ],
      "default": "pending_verification"
    },
    "profile_photo": {
      "type": "string",
      "description": "URL to profile photo"
    },
    "display_name": {
      "type": "string",
      "description": "Preferred display name"
    },
    "emergency_contact": {
      "type": "string",
      "description": "Emergency contact information"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}