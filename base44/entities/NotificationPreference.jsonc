{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User"
    },
    "channel_email_enabled": {
      "type": "boolean",
      "default": true
    },
    "channel_sms_enabled": {
      "type": "boolean",
      "default": true
    },
    "channel_push_enabled": {
      "type": "boolean",
      "default": true
    },
    "channel_in_app_enabled": {
      "type": "boolean",
      "default": true
    },
    "channel_whatsapp_enabled": {
      "type": "boolean",
      "default": false
    },
    "category_transactional_email": {
      "type": "boolean",
      "default": true
    },
    "category_transactional_sms": {
      "type": "boolean",
      "default": true
    },
    "category_marketing_email": {
      "type": "boolean",
      "default": false
    },
    "category_marketing_sms": {
      "type": "boolean",
      "default": false
    },
    "category_system_email": {
      "type": "boolean",
      "default": true
    },
    "category_system_sms": {
      "type": "boolean",
      "default": false
    },
    "category_alert_email": {
      "type": "boolean",
      "default": true
    },
    "category_alert_sms": {
      "type": "boolean",
      "default": true
    },
    "category_reminder_email": {
      "type": "boolean",
      "default": true
    },
    "category_reminder_sms": {
      "type": "boolean",
      "default": true
    },
    "category_crm_email": {
      "type": "boolean",
      "default": true
    },
    "category_crm_sms": {
      "type": "boolean",
      "default": false
    },
    "category_property_email": {
      "type": "boolean",
      "default": true
    },
    "category_project_email": {
      "type": "boolean",
      "default": true
    },
    "category_payment_email": {
      "type": "boolean",
      "default": true
    },
    "category_payment_sms": {
      "type": "boolean",
      "default": true
    },
    "category_account_email": {
      "type": "boolean",
      "default": true
    },
    "category_account_sms": {
      "type": "boolean",
      "default": true
    },
    "digest_enabled": {
      "type": "boolean",
      "default": false
    },
    "digest_frequency": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "digest_time": {
      "type": "string",
      "description": "HH:MM format",
      "default": "08:00"
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": false
    },
    "quiet_hours_start": {
      "type": "string",
      "description": "HH:MM",
      "default": "22:00"
    },
    "quiet_hours_end": {
      "type": "string",
      "description": "HH:MM",
      "default": "07:00"
    },
    "quiet_hours_channel": {
      "type": "string",
      "enum": [
        "all",
        "sms",
        "push"
      ],
      "default": "push"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "timezone": {
      "type": "string",
      "default": "Africa/Lagos"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}