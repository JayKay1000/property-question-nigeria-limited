{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the platform User ID"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true
    },
    "sms_enabled": {
      "type": "boolean",
      "default": false
    },
    "push_enabled": {
      "type": "boolean",
      "default": true
    },
    "marketing_enabled": {
      "type": "boolean",
      "default": false
    },
    "system_alerts_enabled": {
      "type": "boolean",
      "default": true
    },
    "security_alerts_enabled": {
      "type": "boolean",
      "default": true
    },
    "weekly_digest_enabled": {
      "type": "boolean",
      "default": false
    },
    "property_alerts_enabled": {
      "type": "boolean",
      "default": true
    },
    "project_updates_enabled": {
      "type": "boolean",
      "default": true
    },
    "crm_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "quiet_hours_start": {
      "type": "string",
      "description": "Start of quiet hours (HH:mm format)"
    },
    "quiet_hours_end": {
      "type": "string",
      "description": "End of quiet hours (HH:mm format)"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}