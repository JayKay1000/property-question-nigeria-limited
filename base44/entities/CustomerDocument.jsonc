{
  "name": "CustomerDocument",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "identification",
        "agreement",
        "signed_form",
        "contract",
        "correspondence",
        "receipt",
        "certificate",
        "other"
      ],
      "description": "Type of customer document"
    },
    "document_name": {
      "type": "string"
    },
    "document_url": {
      "type": "string",
      "description": "File URL"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploaded_by_name": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "is_confidential": {
      "type": "boolean",
      "default": true
    },
    "related_property_id": {
      "type": "string"
    },
    "related_project_id": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "document_type",
    "document_name",
    "document_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.uploaded_by": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}