{
  "name": "PropertyEnquiry",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "property_title": {
      "type": "string"
    },
    "reference": {
      "type": "string",
      "description": "Human-readable enquiry reference (ENQ-XXXXXXXX), generated server-side"
    },
    "inquiry_category": {
      "type": "string",
      "enum": [
        "general_info",
        "pricing",
        "inspection_request",
        "financing",
        "documentation",
        "availability",
        "joint_venture",
        "other"
      ],
      "default": "general_info",
      "description": "Buyer-selected inquiry category"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Structured questions selected by the buyer from property attributes"
    },
    "customer_id": {
      "type": "string",
      "description": "Platform User ID if registered"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "Enquiry message from customer"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "whatsapp",
        "sms"
      ],
      "default": "phone"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "mobile_app",
        "buy2flip",
        "referral",
        "social_media",
        "call",
        "other"
      ],
      "default": "website"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent entity ID of the advertiser (set server-side)"
    },
    "agent_name": {
      "type": "string",
      "description": "Display name of the advertiser (set server-side)"
    },
    "assigned_to_id": {
      "type": "string",
      "description": "User ID of the assigned agent (for RLS read access)"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "site_visit_scheduled",
        "negotiating",
        "closed_won",
        "closed_lost",
        "nurturing",
        "resolved"
      ],
      "default": "new"
    },
    "inspection_requested": {
      "type": "boolean",
      "default": false,
      "description": "Whether the buyer requested a site inspection with this enquiry"
    },
    "preferred_inspection_date": {
      "type": "string",
      "format": "date",
      "description": "Buyer's preferred inspection date"
    },
    "preferred_inspection_time": {
      "type": "string",
      "description": "Buyer's preferred inspection time slot"
    },
    "inspection_request_id": {
      "type": "string",
      "description": "Reference to InspectionRequest entity if inspection was requested"
    },
    "follow_up_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Follow-up interactions log"
    },
    "next_follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the enquiry was marked resolved"
    },
    "resolved_by": {
      "type": "string",
      "description": "User ID who marked the enquiry resolved"
    },
    "converted_to_lead_id": {
      "type": "string",
      "description": "Reference to Lead entity if converted"
    }
  },
  "required": [
    "property_id",
    "customer_name",
    "status"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}