{
  "name": "UserContact",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the platform User ID"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "primary_phone",
        "secondary_phone",
        "office_phone",
        "whatsapp",
        "telegram",
        "linkedin",
        "website",
        "email",
        "other"
      ],
      "description": "Type of contact method"
    },
    "label": {
      "type": "string",
      "description": "Custom label for this contact"
    },
    "value": {
      "type": "string",
      "description": "The contact value (phone number, URL, handle, etc.)"
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "contact_type",
    "value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}