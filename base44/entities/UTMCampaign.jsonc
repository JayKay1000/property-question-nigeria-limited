{
  "name": "UTMCampaign",
  "type": "object",
  "properties": {
    "campaign_name": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string",
      "description": "Unique tracking code"
    },
    "utm_source": {
      "type": "string",
      "description": "Traffic source e.g. google, facebook, newsletter"
    },
    "utm_medium": {
      "type": "string",
      "description": "Marketing medium e.g. cpc, email, social, referral"
    },
    "utm_campaign": {
      "type": "string",
      "description": "Campaign name identifier"
    },
    "utm_term": {
      "type": "string"
    },
    "utm_content": {
      "type": "string"
    },
    "full_url": {
      "type": "string",
      "description": "Full generated UTM URL"
    },
    "destination_url": {
      "type": "string",
      "description": "Base landing page URL"
    },
    "campaign_type": {
      "type": "string",
      "enum": [
        "search",
        "social",
        "email",
        "display",
        "referral",
        "direct",
        "affiliate"
      ],
      "default": "social"
    },
    "budget": {
      "type": "number",
      "default": 0
    },
    "spend": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "impressions": {
      "type": "number",
      "default": 0
    },
    "conversions": {
      "type": "number",
      "default": 0
    },
    "conversion_value": {
      "type": "number",
      "default": 0
    },
    "ctr": {
      "type": "number",
      "default": 0,
      "description": "Click-through rate %"
    },
    "conversion_rate": {
      "type": "number",
      "default": 0
    },
    "cpc": {
      "type": "number",
      "default": 0
    },
    "roas": {
      "type": "number",
      "default": 0,
      "description": "Return on ad spend"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "campaign_name",
    "utm_source",
    "utm_medium",
    "utm_campaign"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}