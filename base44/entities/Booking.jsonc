{
  "name": "Booking",
  "type": "object",
  "properties": {
    "booking_code": {
      "type": "string",
      "description": "Unique identifier"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "agent",
        "property",
        "project",
        "tour",
        "inspection",
        "consultation",
        "office"
      ],
      "default": "tour"
    },
    "resource_name": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "slot_id": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "tour",
        "inspection",
        "consultation",
        "viewing",
        "meeting",
        "valuation"
      ],
      "default": "tour"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed",
        "no_show",
        "rescheduled"
      ],
      "default": "pending"
    },
    "agent_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    },
    "confirmation_date": {
      "type": "string",
      "format": "date-time"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "booking_code",
    "customer_name",
    "resource_type",
    "booking_type",
    "status"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}