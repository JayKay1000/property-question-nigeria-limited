{
  "name": "PlotReservation",
  "type": "object",
  "properties": {
    "plot_id": {
      "type": "string",
      "description": "Reference to EstatePlot entity"
    },
    "plot_number": {
      "type": "string"
    },
    "estate_id": {
      "type": "string"
    },
    "estate_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer making the reservation"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent handling the reservation"
    },
    "agent_name": {
      "type": "string"
    },
    "reservation_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Reservation expiry date"
    },
    "deposit_amount_ngn": {
      "type": "number",
      "description": "Deposit paid to secure reservation"
    },
    "reservation_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "converted",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    },
    "auto_release": {
      "type": "boolean",
      "default": true,
      "description": "Whether to auto-release on expiry"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "plot_id",
    "customer_name",
    "reservation_status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}