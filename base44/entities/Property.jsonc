{
  "name": "Property",
  "type": "object",
  "title": "Public Property Listing",
  "properties": {
    "title": {
      "type": "string"
    },
    "property_title": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "property_address": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "listing_purpose": {
      "type": "string",
      "enum": [
        "sale",
        "rent",
        "lease"
      ],
      "default": "sale"
    },
    "pricing_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "weekly",
        "daily"
      ],
      "description": "Pricing frequency for rental listings"
    },
    "property_type": {
      "type": "string"
    },
    "bedrooms": {
      "type": "number"
    },
    "bathrooms": {
      "type": "number"
    },
    "toilets": {
      "type": "number"
    },
    "parking_spaces": {
      "type": "number"
    },
    "land_size_sqm": {
      "type": "number"
    },
    "built_up_area_sqm": {
      "type": "number"
    },
    "year_built": {
      "type": "number"
    },
    "plot_dimensions": {
      "type": "string",
      "description": "Plot dimensions e.g. 100x50 ft"
    },
    "property_classification": {
      "type": "string"
    },
    "property_condition": {
      "type": "string"
    },
    "furnishing_status": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "lga": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "estate": {
      "type": "string"
    },
    "address_line": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured_image_url": {
      "type": "string"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "video_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "YouTube or direct video URLs"
    },
    "tour_360_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Equirectangular 360\u00b0 panorama image URLs"
    },
    "reference_number": {
      "type": "string"
    },
    "property_code": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "under_review",
        "verified",
        "approved",
        "published",
        "active",
        "inactive",
        "rejected",
        "suspended"
      ],
      "default": "published"
    },
    "availability_status": {
      "type": "string",
      "default": "available"
    },
    "visibility": {
      "type": "string",
      "default": "public"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "is_new_listing": {
      "type": "boolean",
      "default": true
    },
    "is_joint_venture": {
      "type": "boolean",
      "default": false
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Authenticated user ID of the listing owner (for RLS ownership checks)"
    },
    "listing_agent_id": {
      "type": "string"
    },
    "listing_agent_name": {
      "type": "string"
    },
    "ownership_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Agent confirmed they own or have permission to market this property"
    },
    "ownership_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "marketplace_rejection_reason": {
      "type": "string",
      "description": "Admin feedback when a marketplace listing submission is rejected"
    },
    "property_verification_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "pending",
        "approved",
        "rejected",
        "evidence_requested",
        "revoked"
      ],
      "default": "not_submitted",
      "description": "Property-level verification status \u2014 separate from agent identity/address verification. Set server-side only."
    },
    "property_verification_scope": {
      "type": "string",
      "description": "Human-readable scope of what the property verification actually checked (set by reviewer)"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an admin temporarily suspended the listing"
    },
    "suspended_by": {
      "type": "string",
      "description": "Admin user ID who suspended the listing"
    },
    "suspension_reason": {
      "type": "string",
      "description": "Reason for temporary suspension"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "favorite_count": {
      "type": "number",
      "default": 0
    },
    "source_listing_id": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.visibility": "public",
          "data.status": {
            "$in": [
              "published",
              "active",
              "approved",
              "verified"
            ]
          }
        },
        {
          "$and": [
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}