{
  "name": "Property",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Property listing title"
    },
    "reference_number": {
      "type": "string",
      "description": "Unique property reference (e.g. PQ-PROP-2024-0001)"
    },
    "property_code": {
      "type": "string",
      "description": "Internal property code"
    },
    "slug": {
      "type": "string",
      "description": "SEO-friendly URL slug"
    },
    "description": {
      "type": "string",
      "description": "Full detailed property description"
    },
    "short_description": {
      "type": "string",
      "description": "Brief description for cards and previews"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key selling points and property highlights"
    },
    "property_type": {
      "type": "string",
      "description": "Type of property (house, apartment, land, commercial)"
    },
    "property_category": {
      "type": "string",
      "description": "Category key from PropertyCategory entity (sale, lease, rent, etc.)"
    },
    "property_classification": {
      "type": "string",
      "enum": [
        "ultra_luxury",
        "luxury",
        "premium",
        "standard",
        "budget"
      ],
      "description": "Property quality classification"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "under_review",
        "verified",
        "approved",
        "published",
        "active",
        "inactive",
        "reserved",
        "sold",
        "archived"
      ],
      "default": "draft"
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "under_offer",
        "sold",
        "leased",
        "off_market",
        "withdrawn"
      ],
      "default": "available"
    },
    "property_condition": {
      "type": "string",
      "enum": [
        "new",
        "excellent",
        "good",
        "fair",
        "needs_renovation",
        "under_construction"
      ],
      "description": "Physical condition of the property"
    },
    "development_stage": {
      "type": "string",
      "enum": [
        "land_only",
        "foundation",
        "structure",
        "finishing",
        "completed",
        "off_plan"
      ],
      "description": "Construction/development stage"
    },
    "listing_purpose": {
      "type": "string",
      "enum": [
        "sale",
        "rent",
        "lease"
      ],
      "default": "sale"
    },
    "price": {
      "type": "number",
      "description": "Listing price in NGN"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "bedrooms": {
      "type": "number"
    },
    "bathrooms": {
      "type": "number"
    },
    "parking_spaces": {
      "type": "number"
    },
    "land_size_sqm": {
      "type": "number",
      "description": "Land area in square meters"
    },
    "built_up_area_sqm": {
      "type": "number",
      "description": "Built-up area in square meters"
    },
    "year_built": {
      "type": "number"
    },
    "furnishing_status": {
      "type": "string",
      "enum": [
        "unfurnished",
        "semi_furnished",
        "furnished"
      ]
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of amenity identifiers"
    },
    "address_line": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "Nigerian state"
    },
    "lga": {
      "type": "string",
      "description": "Local Government Area"
    },
    "city": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "estate": {
      "type": "string"
    },
    "street": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "google_maps_link": {
      "type": "string"
    },
    "owner_id": {
      "type": "string",
      "description": "Property owner user ID"
    },
    "owner_name": {
      "type": "string"
    },
    "listing_agent_id": {
      "type": "string",
      "description": "Assigned agent user ID"
    },
    "listing_agent_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "featured_image_url": {
      "type": "string"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "video_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "virtual_tour_url": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured listing flag"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Premium listing flag"
    },
    "is_exclusive": {
      "type": "boolean",
      "default": false,
      "description": "Exclusive listing flag"
    },
    "is_new_listing": {
      "type": "boolean",
      "default": false,
      "description": "New listing flag"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "internal",
        "agents_only"
      ],
      "default": "public",
      "description": "Listing visibility scope"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "favorite_count": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "title",
    "property_type",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.listing_agent_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.listing_agent_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.listing_agent_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}