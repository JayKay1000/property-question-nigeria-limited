{
  "name": "FileDownload",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "media_asset",
        "document",
        "file_version"
      ],
      "description": "Type of downloaded entity"
    },
    "entity_id": {
      "type": "string"
    },
    "entity_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "download_date": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string"
    },
    "device_info": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Geographic location (city/country from IP)"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "personal",
        "sharing",
        "printing",
        "verification",
        "backup",
        "legal",
        "marketing",
        "other"
      ],
      "description": "Purpose of download"
    },
    "file_size_bytes": {
      "type": "number"
    },
    "file_format": {
      "type": "string"
    },
    "share_link_id": {
      "type": "string",
      "description": "If downloaded via share link"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "Whether download was anonymous (public link)"
    },
    "referrer": {
      "type": "string",
      "description": "Source page or referrer"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "download_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}