{
  "name": "SalesPipeline",
  "type": "object",
  "properties": {
    "pipeline_name": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "lead",
        "qualified",
        "inspection",
        "negotiation",
        "reservation",
        "payment",
        "allocation",
        "closed"
      ],
      "default": "lead"
    },
    "stage_entered_date": {
      "type": "string",
      "format": "date-time"
    },
    "pipeline_value_ngn": {
      "type": "number"
    },
    "weighted_value_ngn": {
      "type": "number",
      "description": "Pipeline value \u00d7 probability"
    },
    "probability": {
      "type": "number",
      "default": 0
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "is_closed": {
      "type": "boolean",
      "default": false
    },
    "closed_date": {
      "type": "string",
      "format": "date"
    },
    "closed_won": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "current_stage"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}