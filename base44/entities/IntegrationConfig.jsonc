{
  "name": "IntegrationConfig",
  "type": "object",
  "properties": {
    "integration_code": {
      "type": "string",
      "description": "Unique identifier"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "description": "e.g. google, stripe, resend, flutterwave, mapbox"
    },
    "category": {
      "type": "string",
      "enum": [
        "payments",
        "email",
        "sms",
        "storage",
        "maps",
        "analytics",
        "crm",
        "marketing",
        "ai",
        "auth",
        "social",
        "productivity",
        "general"
      ],
      "default": "general"
    },
    "auth_type": {
      "type": "string",
      "enum": [
        "api_key",
        "oauth",
        "basic",
        "none",
        "webhook"
      ],
      "default": "api_key"
    },
    "base_url": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disabled",
        "error",
        "pending",
        "expired"
      ],
      "default": "pending"
    },
    "health": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "down",
        "unknown"
      ],
      "default": "unknown"
    },
    "version": {
      "type": "string"
    },
    "endpoints_count": {
      "type": "number",
      "default": 0
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "staging",
        "sandbox",
        "development"
      ],
      "default": "production"
    },
    "webhook_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "integration_code",
    "name",
    "provider"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}