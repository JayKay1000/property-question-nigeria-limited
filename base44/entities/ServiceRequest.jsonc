{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "maintenance",
        "repair",
        "property_management",
        "documentation",
        "title_processing",
        "allocation_request",
        "other"
      ],
      "default": "maintenance"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "acknowledged",
        "in_progress",
        "completed",
        "cancelled",
        "on_hold"
      ],
      "default": "submitted"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "expected_completion_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "cost_ngn": {
      "type": "number"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution_notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "request_type",
    "subject",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}