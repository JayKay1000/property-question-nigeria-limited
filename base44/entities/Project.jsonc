{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "reference_number": {
      "type": "string",
      "description": "Unique project reference (e.g. PQ-PROJ-2024-0001)"
    },
    "code": {
      "type": "string",
      "description": "Unique project code (e.g. PQ-PROJ-2024-001)"
    },
    "slug": {
      "type": "string",
      "description": "SEO-friendly URL slug"
    },
    "short_description": {
      "type": "string",
      "description": "Brief description for cards and previews"
    },
    "description": {
      "type": "string",
      "description": "Full detailed project description"
    },
    "project_type": {
      "type": "string",
      "description": "Project type key from ProjectType entity (residential_estate, commercial_estate, mixed_use_estate, etc.)"
    },
    "project_category": {
      "type": "string",
      "description": "Project category classification"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planning",
        "survey_completed",
        "approval_pending",
        "infrastructure_development",
        "construction",
        "selling",
        "allocation",
        "handover",
        "completed",
        "suspended",
        "cancelled",
        "archived"
      ],
      "default": "draft"
    },
    "development_stage": {
      "type": "string",
      "enum": [
        "land_only",
        "survey",
        "layout_approval",
        "infrastructure",
        "construction",
        "selling",
        "handover",
        "completed",
        "off_plan"
      ],
      "description": "Current development stage"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "internal",
        "agents_only"
      ],
      "default": "public",
      "description": "Project visibility scope"
    },
    "launch_date": {
      "type": "string",
      "format": "date",
      "description": "Official project launch date"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_completion_date": {
      "type": "string",
      "format": "date"
    },
    "actual_completion_date": {
      "type": "string",
      "format": "date"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0
    },
    "total_land_area_sqm": {
      "type": "number",
      "description": "Total project land area in square meters"
    },
    "location_state": {
      "type": "string"
    },
    "location_lga": {
      "type": "string"
    },
    "location_city": {
      "type": "string"
    },
    "location_address": {
      "type": "string"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "meta_keywords": {
      "type": "string"
    },
    "featured_video_url": {
      "type": "string"
    },
    "brochure_url": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "google_maps_link": {
      "type": "string"
    },
    "total_units": {
      "type": "number"
    },
    "units_sold": {
      "type": "number",
      "default": 0
    },
    "units_available": {
      "type": "number",
      "default": 0
    },
    "budget_ngn": {
      "type": "number"
    },
    "actual_cost_ngn": {
      "type": "number"
    },
    "project_manager_id": {
      "type": "string"
    },
    "project_manager_name": {
      "type": "string"
    },
    "developer_id": {
      "type": "string"
    },
    "developer_name": {
      "type": "string"
    },
    "primary_estate_id": {
      "type": "string",
      "description": "Reference to primary Estate entity"
    },
    "featured_image_url": {
      "type": "string"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key project selling points"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "project_type",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.project_manager_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.project_manager_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}