{
  "name": "EstatePlot",
  "type": "object",
  "properties": {
    "estate_id": {
      "type": "string",
      "description": "Reference to Estate entity"
    },
    "estate_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "Reference to parent Project entity"
    },
    "layout_id": {
      "type": "string",
      "description": "Reference to EstateLayout entity"
    },
    "plot_number": {
      "type": "string",
      "description": "Plot identifier (e.g. Block A, Plot 12)"
    },
    "plot_code": {
      "type": "string",
      "description": "Unique plot code across the estate/project"
    },
    "block_name": {
      "type": "string",
      "description": "Block within the estate"
    },
    "phase_name": {
      "type": "string",
      "description": "Estate phase this plot belongs to"
    },
    "section_name": {
      "type": "string",
      "description": "Estate section/zone this plot belongs to"
    },
    "property_reference": {
      "type": "string",
      "description": "Reference to linked Property listing"
    },
    "property_id": {
      "type": "string",
      "description": "Property entity ID if linked"
    },
    "plot_size": {
      "type": "number",
      "description": "Plot size value"
    },
    "measurement_unit": {
      "type": "string",
      "enum": [
        "sqm",
        "sqft",
        "acres",
        "hectares",
        "plots"
      ],
      "default": "sqm"
    },
    "facing_direction": {
      "type": "string",
      "enum": [
        "north",
        "south",
        "east",
        "west",
        "north_east",
        "north_west",
        "south_east",
        "south_west"
      ],
      "description": "Plot facing direction"
    },
    "corner_piece": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a corner plot"
    },
    "road_access": {
      "type": "boolean",
      "default": true,
      "description": "Whether plot has direct road access"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "pending_payment",
        "allocated",
        "sold",
        "under_documentation",
        "under_construction",
        "completed",
        "not_available"
      ],
      "default": "available"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "internal",
        "agents_only"
      ],
      "default": "public"
    },
    "price_ngn": {
      "type": "number"
    },
    "buyer_name": {
      "type": "string"
    },
    "reserved_until": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "verified_by": {
      "type": "string"
    }
  },
  "required": [
    "estate_id",
    "plot_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}