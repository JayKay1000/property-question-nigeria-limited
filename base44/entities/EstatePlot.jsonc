{
  "name": "EstatePlot",
  "type": "object",
  "properties": {
    "estate_id": {
      "type": "string",
      "description": "Reference to Estate entity"
    },
    "estate_name": {
      "type": "string"
    },
    "layout_id": {
      "type": "string",
      "description": "Reference to EstateLayout entity"
    },
    "plot_number": {
      "type": "string",
      "description": "Plot identifier (e.g. Block A, Plot 12)"
    },
    "block_name": {
      "type": "string",
      "description": "Block within the estate"
    },
    "plot_size_sqm": {
      "type": "number"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "sold",
        "under_construction",
        "unavailable"
      ],
      "default": "available"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity if linked"
    },
    "price_ngn": {
      "type": "number"
    },
    "buyer_name": {
      "type": "string"
    },
    "reserved_until": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "estate_id",
    "plot_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}