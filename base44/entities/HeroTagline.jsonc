{
  "name": "HeroTagline",
  "type": "object",
  "properties": {
    "tagline_text": {
      "type": "string",
      "description": "The headline text displayed in the hero rotation"
    },
    "display_duration": {
      "type": "number",
      "default": 5,
      "description": "Seconds the tagline remains visible before transitioning"
    },
    "animation_style": {
      "type": "string",
      "enum": [
        "default",
        "fade",
        "typing",
        "word_by_word",
        "slide",
        "blur"
      ],
      "default": "default",
      "description": "Per-tagline animation override; 'default' uses the global CMS setting"
    },
    "is_special": {
      "type": "boolean",
      "default": false,
      "description": "Marks the final/brand tagline for distinctive treatment (glow, underline, longer hold)"
    },
    "is_enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tagline_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}