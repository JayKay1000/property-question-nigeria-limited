{
  "name": "OpportunityStage",
  "type": "object",
  "properties": {
    "stage_key": {
      "type": "string",
      "description": "Unique stage identifier (e.g. prospecting, qualification)"
    },
    "stage_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "probability_percentage": {
      "type": "number",
      "default": 0,
      "description": "Default win probability for this stage"
    },
    "category": {
      "type": "string",
      "enum": [
        "active",
        "won",
        "lost"
      ],
      "default": "active"
    },
    "is_terminal": {
      "type": "boolean",
      "default": false
    },
    "color": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "stage_key",
    "stage_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}