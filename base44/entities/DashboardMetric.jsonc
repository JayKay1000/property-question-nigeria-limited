{
  "name": "DashboardMetric",
  "type": "object",
  "properties": {
    "metric_code": {
      "type": "string"
    },
    "widget_name": {
      "type": "string",
      "description": "Display name for the dashboard widget"
    },
    "description": {
      "type": "string"
    },
    "dashboard_type": {
      "type": "string",
      "enum": [
        "executive",
        "sales",
        "marketing",
        "projects",
        "construction",
        "property_management",
        "crm",
        "customer_service",
        "finance",
        "security",
        "operations"
      ],
      "description": "Which dashboard this metric belongs to"
    },
    "metric_type": {
      "type": "string",
      "enum": [
        "counter",
        "gauge",
        "chart",
        "table",
        "progress",
        "trend",
        "funnel",
        "heatmap",
        "list"
      ],
      "description": "Visualization type"
    },
    "metric_value": {
      "type": "number"
    },
    "metric_label": {
      "type": "string"
    },
    "metric_data": {
      "type": "object",
      "description": "Structured data for charts/graphs"
    },
    "data_source": {
      "type": "string",
      "description": "Entity or API providing the data"
    },
    "query_template": {
      "type": "string",
      "description": "Query or filter used to compute the metric"
    },
    "refresh_frequency": {
      "type": "string",
      "enum": [
        "realtime",
        "hourly",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "daily"
    },
    "last_refreshed": {
      "type": "string",
      "format": "date-time"
    },
    "icon": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "metric_code",
    "widget_name",
    "dashboard_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}