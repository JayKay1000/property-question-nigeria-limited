{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "client_title": {
      "type": "string"
    },
    "client_company": {
      "type": "string"
    },
    "client_photo_url": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5,
      "description": "1-5 stars"
    },
    "testimonial_text": {
      "type": "string"
    },
    "service_used": {
      "type": "string",
      "description": "e.g. Property Purchase, Project Investment, Property Management"
    },
    "property_reference": {
      "type": "string"
    },
    "project_reference": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_approved": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "client_name",
    "testimonial_text",
    "rating"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}