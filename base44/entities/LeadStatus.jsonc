{
  "name": "LeadStatus",
  "type": "object",
  "properties": {
    "status_key": {
      "type": "string",
      "description": "Unique status identifier (e.g. new, contacted, qualified)"
    },
    "status_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "active",
        "won",
        "lost",
        "dormant"
      ],
      "default": "active"
    },
    "is_terminal": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a terminal status"
    },
    "color": {
      "type": "string",
      "description": "Hex color for UI display"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "status_key",
    "status_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}