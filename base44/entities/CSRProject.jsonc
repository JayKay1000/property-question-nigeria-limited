{
  "name": "CSRProject",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "csr_category": {
      "type": "string",
      "enum": [
        "education",
        "health",
        "environment",
        "community",
        "youth_empowerment",
        "infrastructure",
        "charity"
      ],
      "default": "community"
    },
    "impact_summary": {
      "type": "string"
    },
    "beneficiary_count": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "ongoing",
        "completed"
      ],
      "default": "ongoing"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "csr_category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}