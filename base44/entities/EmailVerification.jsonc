{
  "name": "EmailVerification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the platform User ID"
    },
    "email": {
      "type": "string",
      "description": "Email address being verified"
    },
    "verification_token": {
      "type": "string",
      "description": "Token sent for verification"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "resend_count": {
      "type": "number",
      "default": 0
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "expired",
        "failed"
      ],
      "default": "pending"
    },
    "ip_address": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "email",
    "verification_status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}