{
  "name": "ESignature",
  "type": "object",
  "properties": {
    "signature_code": {
      "type": "string",
      "description": "Unique identifier"
    },
    "document_title": {
      "type": "string"
    },
    "document_url": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "contract",
        "agreement",
        "power_of_attorney",
        "nda",
        "offer_letter",
        "receipt",
        "deed",
        "other"
      ],
      "default": "contract"
    },
    "requester_name": {
      "type": "string"
    },
    "requester_email": {
      "type": "string"
    },
    "signer_name": {
      "type": "string"
    },
    "signer_email": {
      "type": "string"
    },
    "signer_phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "signed",
        "declined",
        "expired",
        "voided"
      ],
      "default": "draft"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_data_url": {
      "type": "string",
      "description": "Captured signature image URL"
    },
    "ip_address": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "reminders_sent": {
      "type": "number",
      "default": 0
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "signature_code",
    "document_title",
    "signer_name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}