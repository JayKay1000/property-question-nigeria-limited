{
  "name": "InspectionRequest",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "property_title": {
      "type": "string"
    },
    "enquiry_id": {
      "type": "string",
      "description": "Reference to the PropertyEnquiry that triggered this inspection"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent entity ID of the advertiser (set server-side)"
    },
    "customer_id": {
      "type": "string",
      "description": "Platform User ID if registered"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "requested_time": {
      "type": "string",
      "description": "Preferred time slot"
    },
    "confirmed_date": {
      "type": "string",
      "format": "date"
    },
    "confirmed_time": {
      "type": "string"
    },
    "proposed_date": {
      "type": "string",
      "format": "date",
      "description": "Alternative date proposed by the agent (awaiting buyer acceptance)"
    },
    "proposed_time": {
      "type": "string",
      "description": "Alternative time proposed by the agent"
    },
    "proposed_by": {
      "type": "string",
      "enum": [
        "agent",
        "buyer"
      ],
      "description": "Who proposed the alternative time"
    },
    "sales_representative_id": {
      "type": "string",
      "description": "User ID of the assigned agent (for RLS)"
    },
    "sales_representative_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled",
        "rescheduled",
        "no_show"
      ],
      "default": "pending"
    },
    "inspection_notes": {
      "type": "string"
    },
    "cancelled_reason": {
      "type": "string",
      "description": "Reason for cancellation"
    },
    "cancelled_by": {
      "type": "string",
      "description": "User ID who cancelled the inspection"
    },
    "number_of_attendees": {
      "type": "number",
      "default": 1
    },
    "transportation_needed": {
      "type": "boolean",
      "default": false
    },
    "feedback_rating": {
      "type": "number"
    },
    "feedback_notes": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "customer_name",
    "requested_date",
    "status"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.sales_representative_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sales_representative_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}