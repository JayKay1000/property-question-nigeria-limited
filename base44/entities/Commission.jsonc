{
  "name": "Commission",
  "type": "object",
  "properties": {
    "commission_code": {
      "type": "string",
      "description": "Unique identifier"
    },
    "agent_id": {
      "type": "string",
      "description": "Reference to Agent"
    },
    "agent_name": {
      "type": "string"
    },
    "agent_email": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string",
      "description": "Reference to Opportunity"
    },
    "deal_reference": {
      "type": "string",
      "description": "Deal or transaction reference"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "commission_type": {
      "type": "string",
      "enum": [
        "sale",
        "referral",
        "management",
        "consultation",
        "valuation",
        "leasing"
      ],
      "default": "sale"
    },
    "commission_rate": {
      "type": "number",
      "description": "Percentage rate e.g. 5 means 5%"
    },
    "commission_amount": {
      "type": "number",
      "description": "Calculated commission in NGN"
    },
    "base_amount": {
      "type": "number",
      "description": "Deal/transaction value the commission is based on"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid",
        "disputed",
        "cancelled",
        "reversed"
      ],
      "default": "pending"
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "payment_reference": {
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "tax_deduction": {
      "type": "number",
      "default": 0
    },
    "net_amount": {
      "type": "number",
      "description": "Amount after tax"
    },
    "notes": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "commission_code",
    "agent_name",
    "commission_type",
    "commission_amount",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}