{
  "name": "PropertyTag",
  "type": "object",
  "properties": {
    "tag_key": {
      "type": "string",
      "description": "Unique tag identifier (e.g. luxury, waterfront, gated_estate)"
    },
    "tag_name": {
      "type": "string",
      "description": "Display name"
    },
    "description": {
      "type": "string"
    },
    "tag_color": {
      "type": "string",
      "description": "Hex color for UI display"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "Number of properties using this tag"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tag_key",
    "tag_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}