{
  "name": "ContactSubmission",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "inquiry_type": {
      "type": "string",
      "enum": [
        "consultation",
        "inspection",
        "general",
        "partnership",
        "career",
        "press",
        "complaint"
      ],
      "default": "general"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "whatsapp"
      ],
      "default": "email"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "preferred_time": {
      "type": "string"
    },
    "source_page": {
      "type": "string",
      "description": "Page where form was submitted"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "resolved",
        "converted",
        "archived"
      ],
      "default": "new"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "lead_reference": {
      "type": "string",
      "description": "CRM Lead reference if converted"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email",
    "message"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}