{
  "name": "CommunicationCampaign",
  "type": "object",
  "properties": {
    "campaign_reference": {
      "type": "string",
      "description": "Unique e.g. CMP-2026-0001"
    },
    "campaign_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "campaign_type": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "push",
        "whatsapp",
        "multi_channel"
      ],
      "default": "email"
    },
    "category": {
      "type": "string",
      "enum": [
        "marketing",
        "announcement",
        "newsletter",
        "promotional",
        "event",
        "alert",
        "re_engagement"
      ],
      "default": "marketing"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sending",
        "sent",
        "paused",
        "cancelled",
        "failed"
      ],
      "default": "draft"
    },
    "template_id": {
      "type": "string",
      "description": "Reference to NotificationTemplate"
    },
    "subject_override": {
      "type": "string"
    },
    "body_override": {
      "type": "string"
    },
    "audience_type": {
      "type": "string",
      "enum": [
        "all_users",
        "segment",
        "filtered",
        "manual_list",
        "role_based",
        "entity_based"
      ],
      "default": "all_users"
    },
    "audience_filter": {
      "type": "object",
      "description": "MongoDB-style filter for audience selection"
    },
    "audience_count": {
      "type": "number",
      "default": 0
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "delivered_count": {
      "type": "number",
      "default": 0
    },
    "read_count": {
      "type": "number",
      "default": 0
    },
    "failed_count": {
      "type": "number",
      "default": 0
    },
    "bounced_count": {
      "type": "number",
      "default": 0
    },
    "opted_out_count": {
      "type": "number",
      "default": 0
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "sms",
          "push",
          "whatsapp"
        ]
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence_pattern": {
      "type": "string",
      "description": "Cron expression"
    },
    "next_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "campaign_name",
    "campaign_type",
    "category",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}