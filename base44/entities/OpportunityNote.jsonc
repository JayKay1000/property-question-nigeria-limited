{
  "name": "OpportunityNote",
  "type": "object",
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "note_text": {
      "type": "string"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "internal",
        "customer_facing",
        "action_item",
        "strategy"
      ],
      "default": "internal"
    },
    "authored_by": {
      "type": "string"
    },
    "authored_by_name": {
      "type": "string"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_urgent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "opportunity_id",
    "note_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.authored_by": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.authored_by": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}