{
  "name": "LookupState",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "State code (e.g. LG for Lagos)"
    },
    "name": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "enum": [
        "north_central",
        "north_east",
        "north_west",
        "south_east",
        "south_south",
        "south_west"
      ]
    },
    "capital": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "name"
  ]
}