{
  "name": "UserRole",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the platform User ID"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "role_key": {
      "type": "string",
      "description": "Role identifier from Role entity"
    },
    "role_name": {
      "type": "string"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the user's primary role"
    },
    "assigned_by": {
      "type": "string",
      "description": "User ID of the assigner"
    },
    "assigned_by_name": {
      "type": "string"
    },
    "assigned_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiry for temporary role assignments"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by": {
      "type": "string"
    },
    "revoke_reason": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "role_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}