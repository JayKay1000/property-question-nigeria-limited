{
  "name": "Service",
  "type": "object",
  "properties": {
    "service_code": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "full_description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "category": {
      "type": "string",
      "enum": [
        "agency",
        "management",
        "construction",
        "development",
        "advisory",
        "valuation",
        "marketing"
      ],
      "default": "agency"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "service_code",
    "service_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}