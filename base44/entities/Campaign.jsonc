{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "campaign_name": {
      "type": "string"
    },
    "campaign_type": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "whatsapp",
        "social",
        "property_launch",
        "buy2flip_promotion",
        "multi_channel",
        "event"
      ],
      "default": "email"
    },
    "channel": {
      "type": "string",
      "description": "Primary channel"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "active",
        "paused",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "budget_ngn": {
      "type": "number"
    },
    "actual_cost_ngn": {
      "type": "number",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "target_audience": {
      "type": "string",
      "description": "Audience segment description"
    },
    "objectives": {
      "type": "string",
      "description": "Campaign objectives and goals"
    },
    "target_audience_count": {
      "type": "number",
      "default": 0
    },
    "total_sent": {
      "type": "number",
      "default": 0
    },
    "total_conversions": {
      "type": "number",
      "default": 0
    },
    "conversion_count": {
      "type": "number",
      "default": 0
    },
    "revenue_generated_ngn": {
      "type": "number",
      "default": 0
    },
    "roi_percentage": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "campaign_name",
    "campaign_type",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}