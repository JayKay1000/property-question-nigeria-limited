{
  "name": "LookupPropertyType",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Short code (e.g. house, apartment, land)"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "category": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "industrial",
        "land",
        "mixed_use"
      ]
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "label"
  ]
}