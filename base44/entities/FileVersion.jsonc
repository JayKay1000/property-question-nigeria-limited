{
  "name": "FileVersion",
  "type": "object",
  "properties": {
    "media_asset_id": {
      "type": "string",
      "description": "Reference to MediaAsset (if media file)"
    },
    "document_id": {
      "type": "string",
      "description": "Reference to Document (if document)"
    },
    "version_number": {
      "type": "number",
      "description": "Sequential version number"
    },
    "version_label": {
      "type": "string",
      "description": "Display label (v1, v2, Revision A)"
    },
    "file_url": {
      "type": "string",
      "description": "Storage URL for this version"
    },
    "file_name": {
      "type": "string"
    },
    "file_size_bytes": {
      "type": "number"
    },
    "checksum": {
      "type": "string",
      "description": "File hash for this version"
    },
    "change_notes": {
      "type": "string",
      "description": "What changed in this version"
    },
    "upload_reason": {
      "type": "string",
      "description": "Why this version was uploaded"
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploaded_by_name": {
      "type": "string"
    },
    "upload_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_current_version": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the active current version"
    },
    "is_approved_version": {
      "type": "boolean",
      "default": false
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_version_id": {
      "type": "string",
      "description": "Reference to previous FileVersion"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "file_extension": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    }
  },
  "required": [
    "version_number",
    "file_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.uploaded_by": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}