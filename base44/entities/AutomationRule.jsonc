{
  "name": "AutomationRule",
  "type": "object",
  "properties": {
    "rule_code": {
      "type": "string",
      "description": "Unique e.g. auto_create_task_on_lead"
    },
    "rule_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "enum": [
        "crm",
        "property",
        "project",
        "agent",
        "customer",
        "notification",
        "document",
        "financial",
        "security",
        "general"
      ],
      "default": "crm"
    },
    "trigger_entity": {
      "type": "string",
      "description": "Entity to watch"
    },
    "trigger_event": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "deleted",
        "status_changed",
        "field_changed",
        "scheduled",
        "reminder"
      ],
      "default": "created"
    },
    "trigger_condition": {
      "type": "object",
      "description": "MongoDB-style filter for additional conditions"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "create_task",
        "send_notification",
        "create_lead",
        "create_opportunity",
        "update_record",
        "send_email",
        "send_sms",
        "assign_user",
        "schedule_reminder",
        "create_follow_up",
        "segment_customer",
        "trigger_workflow"
      ],
      "default": "create_task"
    },
    "action_config": {
      "type": "object",
      "description": "Configuration for the action (field mappings, templates, etc.)"
    },
    "target_entity": {
      "type": "string",
      "description": "Entity the action targets"
    },
    "target_template_id": {
      "type": "string",
      "description": "Template to use for the action"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "record_owner",
        "assigned_user",
        "role_based",
        "specific_users",
        "entity_related_users"
      ],
      "default": "assigned_user"
    },
    "target_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "delay_minutes": {
      "type": "number",
      "default": 0
    },
    "cooldown_minutes": {
      "type": "number",
      "description": "Prevent duplicate within window"
    },
    "max_executions_per_day": {
      "type": "number"
    },
    "execution_count": {
      "type": "number",
      "default": 0
    },
    "last_executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_execution_status": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "rule_code",
    "rule_name",
    "trigger_entity",
    "trigger_event",
    "action_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}