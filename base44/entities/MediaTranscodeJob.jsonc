{
  "name": "MediaTranscodeJob",
  "type": "object",
  "properties": {
    "job_code": {
      "type": "string",
      "description": "Unique identifier"
    },
    "source_url": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "video",
        "image",
        "audio",
        "document"
      ],
      "default": "video"
    },
    "output_format": {
      "type": "string",
      "enum": [
        "mp4",
        "webm",
        "hls",
        "webp",
        "mp3",
        "ogg",
        "pdf"
      ],
      "default": "mp4"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "processing",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "queued"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "0-100"
    },
    "output_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "video_bitrate": {
      "type": "string",
      "description": "e.g. 2500k"
    },
    "audio_bitrate": {
      "type": "string",
      "description": "e.g. 128k"
    },
    "resolution": {
      "type": "string",
      "description": "e.g. 1080p, 720p"
    },
    "duration_seconds": {
      "type": "number"
    },
    "file_size_mb": {
      "type": "number"
    },
    "watermark_applied": {
      "type": "boolean",
      "default": false
    },
    "watermark_config_id": {
      "type": "string"
    },
    "ai_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_confidence": {
      "type": "number"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "job_code",
    "source_name",
    "output_format",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}