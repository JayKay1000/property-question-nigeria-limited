{
  "name": "CRMActivity",
  "type": "object",
  "properties": {
    "activity_type": {
      "type": "string",
      "enum": [
        "call",
        "email",
        "sms",
        "whatsapp",
        "meeting",
        "video_call",
        "site_visit",
        "property_tour",
        "note",
        "follow_up",
        "document_shared",
        "quotation_sent"
      ],
      "description": "Type of customer interaction"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "activity_date": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "successful",
        "no_answer",
        "voicemail",
        "rescheduled",
        "cancelled",
        "pending",
        "informational"
      ],
      "default": "pending"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "internal"
      ],
      "default": "outbound"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "activity_type",
    "activity_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.staff_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.staff_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.staff_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}