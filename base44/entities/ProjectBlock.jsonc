{
  "name": "ProjectBlock",
  "type": "object",
  "properties": {
    "estate_id": {
      "type": "string",
      "description": "Reference to Estate entity"
    },
    "estate_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "phase_name": {
      "type": "string",
      "description": "Phase this block belongs to"
    },
    "section_name": {
      "type": "string",
      "description": "Section this block belongs to"
    },
    "block_name": {
      "type": "string",
      "description": "Block name (e.g. Block A, Block 1)"
    },
    "block_code": {
      "type": "string"
    },
    "number_of_plots": {
      "type": "number",
      "default": 0
    },
    "plots_sold": {
      "type": "number",
      "default": 0
    },
    "plots_available": {
      "type": "number",
      "default": 0
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "estate_id",
    "block_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}