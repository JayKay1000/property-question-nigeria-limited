{
  "name": "DevelopmentArea",
  "type": "object",
  "properties": {
    "development_area_name": {
      "type": "string"
    },
    "parent_lga_name": {
      "type": "string"
    },
    "parent_lga_code": {
      "type": "string"
    },
    "state_code": {
      "type": "string"
    },
    "state_name": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "proposed",
        "dissolved"
      ],
      "default": "active"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "development_area_name",
    "state_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}