{
  "name": "FileAccessLog",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "media_asset",
        "document",
        "folder",
        "file_version",
        "share_link"
      ],
      "description": "Type of entity accessed"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the accessed entity"
    },
    "entity_name": {
      "type": "string",
      "description": "Display name of accessed entity"
    },
    "action": {
      "type": "string",
      "enum": [
        "view",
        "download",
        "upload",
        "replace",
        "delete",
        "share",
        "approve",
        "reject",
        "archive",
        "restore",
        "metadata_edit",
        "permission_change",
        "share_access",
        "preview",
        "stream"
      ],
      "description": "Action performed on the entity"
    },
    "user_id": {
      "type": "string",
      "description": "User who performed the action"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "ip_address": {
      "type": "string",
      "description": "Request IP address"
    },
    "device_info": {
      "type": "string",
      "description": "User agent / device information"
    },
    "session_id": {
      "type": "string"
    },
    "access_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "denied",
        "error",
        "expired"
      ],
      "default": "success"
    },
    "denial_reason": {
      "type": "string",
      "description": "Why access was denied (if applicable)"
    },
    "file_size_bytes": {
      "type": "number",
      "description": "Size of file involved in the action"
    },
    "referrer": {
      "type": "string",
      "description": "Referrer URL/page"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "action",
    "access_timestamp"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}