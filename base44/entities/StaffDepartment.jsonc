{
  "name": "StaffDepartment",
  "type": "object",
  "properties": {
    "department_code": {
      "type": "string",
      "description": "Unique department code (e.g. SALES, LEGAL, CONSTRUCTION)"
    },
    "department_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parent_department_id": {
      "type": "string",
      "description": "Parent department for hierarchical structure"
    },
    "parent_department_name": {
      "type": "string"
    },
    "head_of_department_id": {
      "type": "string",
      "description": "User ID of the department head"
    },
    "head_of_department_name": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "department_code",
    "department_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}