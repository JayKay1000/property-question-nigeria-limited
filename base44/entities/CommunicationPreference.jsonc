{
  "name": "CommunicationPreference",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "preferred_channel": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "sms",
        "whatsapp",
        "in_person",
        "none"
      ],
      "default": "phone"
    },
    "email_opt_in": {
      "type": "boolean",
      "default": true
    },
    "sms_opt_in": {
      "type": "boolean",
      "default": true
    },
    "whatsapp_opt_in": {
      "type": "boolean",
      "default": false
    },
    "call_opt_in": {
      "type": "boolean",
      "default": true
    },
    "marketing_emails": {
      "type": "boolean",
      "default": false
    },
    "transactional_emails": {
      "type": "boolean",
      "default": true
    },
    "newsletter": {
      "type": "boolean",
      "default": false
    },
    "inspection_reminders": {
      "type": "boolean",
      "default": true
    },
    "payment_reminders": {
      "type": "boolean",
      "default": true
    },
    "do_not_disturb": {
      "type": "boolean",
      "default": false
    },
    "dnd_start_time": {
      "type": "string",
      "description": "DND start time (e.g. 20:00)"
    },
    "dnd_end_time": {
      "type": "string",
      "description": "DND end time (e.g. 08:00)"
    },
    "language_preference": {
      "type": "string",
      "default": "en"
    }
  },
  "required": [
    "customer_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}