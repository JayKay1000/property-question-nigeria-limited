{
  "name": "Landmark",
  "type": "object",
  "properties": {
    "landmark_name": {
      "type": "string"
    },
    "landmark_type": {
      "type": "string",
      "enum": [
        "school",
        "hospital",
        "market",
        "shopping_mall",
        "church",
        "mosque",
        "police_station",
        "airport",
        "bus_stop",
        "rail_station",
        "beach",
        "hotel",
        "restaurant",
        "bank",
        "government_office",
        "university",
        "park",
        "stadium",
        "tourist_attraction",
        "other"
      ]
    },
    "state_code": {
      "type": "string"
    },
    "state_name": {
      "type": "string"
    },
    "lga_name": {
      "type": "string"
    },
    "city_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "google_maps_link": {
      "type": "string"
    },
    "google_place_id": {
      "type": "string"
    },
    "opening_hours": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "landmark_name",
    "landmark_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}