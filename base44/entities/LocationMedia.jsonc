{
  "name": "LocationMedia",
  "type": "object",
  "properties": {
    "location_type": {
      "type": "string",
      "enum": [
        "area",
        "neighborhood",
        "estate",
        "street",
        "landmark"
      ],
      "description": "What the media represents"
    },
    "location_name": {
      "type": "string"
    },
    "location_id": {
      "type": "string",
      "description": "Entity ID if linked"
    },
    "state_code": {
      "type": "string"
    },
    "city_name": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "area_image",
        "drone_photo",
        "area_video",
        "neighborhood_video",
        "brochure",
        "map",
        "satellite_image"
      ],
      "default": "area_image"
    },
    "media_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "capture_date": {
      "type": "string",
      "format": "date"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "display_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "location_type",
    "location_name",
    "media_type",
    "media_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}