{
  "name": "Complaint",
  "type": "object",
  "properties": {
    "complaint_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "complaint_type": {
      "type": "string",
      "enum": [
        "service_quality",
        "staff_conduct",
        "property_defect",
        "documentation_delay",
        "payment_dispute",
        "communication_failure",
        "other"
      ]
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "minor",
        "moderate",
        "serious",
        "severe",
        "critical"
      ],
      "default": "moderate"
    },
    "status": {
      "type": "string",
      "enum": [
        "lodged",
        "under_investigation",
        "resolved",
        "unresolved",
        "escalated",
        "withdrawn"
      ],
      "default": "lodged"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "satisfaction_score": {
      "type": "number",
      "description": "1-5 satisfaction score after resolution"
    },
    "related_property_id": {
      "type": "string"
    },
    "related_ticket_id": {
      "type": "string"
    },
    "investigation_notes": {
      "type": "string"
    },
    "compensation_offered": {
      "type": "boolean",
      "default": false
    },
    "compensation_amount_ngn": {
      "type": "number"
    }
  },
  "required": [
    "customer_id",
    "complaint_type",
    "subject",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}