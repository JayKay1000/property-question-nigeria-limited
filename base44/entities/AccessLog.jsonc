{
  "name": "AccessLog",
  "type": "object",
  "properties": {
    "access_reference": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "description": "Type of resource accessed (page, document, api_endpoint, entity_record)"
    },
    "resource_id": {
      "type": "string"
    },
    "resource_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "view",
        "read",
        "download",
        "export",
        "print",
        "share",
        "access"
      ],
      "default": "view"
    },
    "access_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "module": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "device_info": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "operating_system": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "success": {
      "type": "boolean",
      "default": true
    },
    "failure_reason": {
      "type": "string"
    },
    "permission_required": {
      "type": "string",
      "description": "Permission that was checked"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "user_id",
    "resource_type",
    "action"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}