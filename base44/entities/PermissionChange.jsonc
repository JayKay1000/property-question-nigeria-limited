{
  "name": "PermissionChange",
  "type": "object",
  "properties": {
    "change_reference": {
      "type": "string"
    },
    "role_key": {
      "type": "string",
      "description": "Role affected by the change"
    },
    "role_name": {
      "type": "string"
    },
    "permission_key": {
      "type": "string",
      "description": "Permission affected"
    },
    "permission_name": {
      "type": "string"
    },
    "change_type": {
      "type": "string",
      "enum": [
        "grant",
        "revoke",
        "modify",
        "inherit",
        "override"
      ],
      "description": "Type of permission change"
    },
    "previous_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "inherited",
        "none"
      ],
      "description": "Previous permission effect"
    },
    "new_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "inherited",
        "none"
      ],
      "description": "New permission effect"
    },
    "previous_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "changed_by_id": {
      "type": "string"
    },
    "changed_by_name": {
      "type": "string"
    },
    "changed_date": {
      "type": "string",
      "format": "date-time"
    },
    "change_reason": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_required"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "affected_user_count": {
      "type": "number",
      "default": 0,
      "description": "Number of users affected by this change"
    },
    "module": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "role_key",
    "permission_key",
    "change_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}