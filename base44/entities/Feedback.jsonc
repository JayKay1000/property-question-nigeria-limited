{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "review",
        "rating",
        "suggestion",
        "complaint",
        "testimonial"
      ],
      "default": "review"
    },
    "rating": {
      "type": "number",
      "description": "1-5 star rating"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "flagged",
        "under_review"
      ],
      "default": "pending"
    },
    "moderated_by": {
      "type": "string"
    },
    "moderated_at": {
      "type": "string",
      "format": "date-time"
    },
    "moderation_notes": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether feedback is displayed publicly"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "response": {
      "type": "string",
      "description": "Official response to the feedback"
    },
    "responded_by": {
      "type": "string"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_id",
    "feedback_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_public": true
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}