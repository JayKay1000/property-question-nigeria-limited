{
  "name": "SavedProperty",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who saved the property"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "property_title": {
      "type": "string"
    },
    "collection_name": {
      "type": "string",
      "default": "Favorites",
      "description": "Named collection (future-ready)"
    },
    "saved_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "is_shared": {
      "type": "boolean",
      "default": false,
      "description": "Future-ready collection sharing"
    }
  },
  "required": [
    "user_id",
    "property_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}