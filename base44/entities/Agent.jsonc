{
  "name": "Agent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Associated platform user ID"
    },
    "agent_code": {
      "type": "string",
      "description": "Unique agent code (e.g. PQ-AGT-0001)"
    },
    "full_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string",
      "description": "First name (marketplace agent registration)"
    },
    "last_name": {
      "type": "string",
      "description": "Last name (marketplace agent registration)"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "address": {
      "type": "string",
      "description": "Official/residential address"
    },
    "resident_state": {
      "type": "string",
      "description": "Nigerian state of residence"
    },
    "resident_lga": {
      "type": "string",
      "description": "Local Government Area of residence"
    },
    "bio": {
      "type": "string"
    },
    "specialization": {
      "type": "string",
      "description": "e.g. Residential, Commercial, Land"
    },
    "years_experience": {
      "type": "number"
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "verified",
        "active",
        "inactive",
        "suspended",
        "terminated"
      ],
      "default": "pending"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "tier": {
      "type": "string",
      "enum": [
        "basic",
        "identity_verified",
        "address_verified"
      ],
      "default": "basic",
      "description": "Marketplace listing tier \u2014 derived from approved verification records by the backend, not client-settable"
    },
    "identity_verification_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_submitted",
      "description": "Tier 2 identity verification status"
    },
    "address_verification_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_submitted",
      "description": "Tier 3 address verification status"
    },
    "marketplace_terms_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Agent accepted the marketplace terms and privacy notice"
    },
    "marketplace_terms_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "license_number": {
      "type": "string"
    },
    "license_expiry": {
      "type": "string",
      "format": "date"
    },
    "total_listings": {
      "type": "number",
      "default": 0
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "total_commission_ngn": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "commission_rate": {
      "type": "number",
      "description": "Commission percentage"
    },
    "supervisor_id": {
      "type": "string"
    },
    "supervisor_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "full_name",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}