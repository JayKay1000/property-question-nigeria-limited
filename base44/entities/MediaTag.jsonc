{
  "name": "MediaTag",
  "type": "object",
  "properties": {
    "tag_key": {
      "type": "string",
      "description": "Unique tag identifier (e.g. luxury, verified, survey)"
    },
    "tag_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tag_color": {
      "type": "string",
      "description": "Hex color for UI display"
    },
    "tag_type": {
      "type": "string",
      "enum": [
        "content",
        "status",
        "classification",
        "quality",
        "security",
        "custom"
      ],
      "default": "content"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "Number of assets/documents using this tag"
    },
    "is_system_tag": {
      "type": "boolean",
      "default": false,
      "description": "System tags cannot be deleted"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tag_key",
    "tag_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}