{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string",
      "description": "Unique ticket number (e.g. PQ-TKT-2024-0001)"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "complaint",
        "enquiry",
        "maintenance",
        "property_management",
        "billing",
        "documentation",
        "other"
      ],
      "default": "enquiry"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting_customer",
        "escalated",
        "resolved",
        "closed",
        "reopened"
      ],
      "default": "open"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "sla_due_date": {
      "type": "string",
      "format": "date-time"
    },
    "sla_breached": {
      "type": "boolean",
      "default": false
    },
    "resolution": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "customer_satisfaction_rating": {
      "type": "number",
      "description": "1-5 satisfaction rating"
    },
    "created_channel": {
      "type": "string",
      "enum": [
        "web",
        "email",
        "phone",
        "whatsapp",
        "in_person",
        "agent_portal",
        "customer_portal"
      ],
      "default": "web"
    },
    "related_property_id": {
      "type": "string"
    },
    "related_project_id": {
      "type": "string"
    },
    "escalated_to": {
      "type": "string"
    },
    "escalated_at": {
      "type": "string",
      "format": "date-time"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "ticket_number",
    "customer_id",
    "subject",
    "priority",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}