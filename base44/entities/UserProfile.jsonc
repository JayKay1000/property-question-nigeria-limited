{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the platform User ID"
    },
    "bio": {
      "type": "string",
      "description": "User biography / about section"
    },
    "occupation": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "social_links": {
      "type": "object",
      "description": "Structured social media links (linkedin, twitter, instagram, facebook, website)"
    },
    "marketing_preferences": {
      "type": "object",
      "description": "Marketing opt-in/out settings"
    },
    "communication_preferences": {
      "type": "object",
      "description": "Communication channel preferences"
    },
    "accessibility_preferences": {
      "type": "object",
      "description": "Accessibility settings (font size, contrast, screen reader, etc.)"
    },
    "profile_completion_percentage": {
      "type": "number",
      "default": 0,
      "description": "Calculated profile completeness score 0-100"
    },
    "last_profile_update": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}